document.addEventListener("DOMContentLoaded", () => {

    const usernameField = document.getElementById("username");
    if (usernameField) {
        usernameField.addEventListener("keypress", function (event) {
            if (event.key === "Enter") fetchGames();
        });
    }

    const fetchBtn = document.getElementById("fetch-games-btn");
    if (fetchBtn) fetchBtn.addEventListener("click", fetchGames);

    const btnStart = document.getElementById("btn-start");
    const btnPrev = document.getElementById("btn-prev");
    const btnNext = document.getElementById("btn-next");
    const btnEnd = document.getElementById("btn-end");

    if (btnStart) btnStart.addEventListener("click", goToStart);
    if (btnPrev) btnPrev.addEventListener("click", previousMove);
    if (btnNext) btnNext.addEventListener("click", nextMove);
    if (btnEnd) btnEnd.addEventListener("click", goToEnd);

    const shareBtn = document.getElementById("share-btn");
    const downloadBtn = document.getElementById("download-btn");

    if (shareBtn) shareBtn.addEventListener("click", shareGame);
    if (downloadBtn) downloadBtn.addEventListener("click", downloadPgn);

    document.addEventListener("keydown", event => {

        const analyserSection = document.getElementById("analyser");

        if (
            !analyserSection ||
            analyserSection.classList.contains("hidden")
        ) return;

        if (event.key === "ArrowRight") nextMove();
        else if (event.key === "ArrowLeft") previousMove();
    });

    window.addEventListener("resize", () => {
        if (board) board.resize();
    });

    if (typeof isLoggedIn === "function" && isLoggedIn()) {
        renderHistory();
    }

    loadSharedGameFromUrl();
});