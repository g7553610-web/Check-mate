function svgToDataUri(svg) {
    return "data:image/svg+xml;base64," +
        btoa(unescape(encodeURIComponent(svg)));
}

/* Build a lookup of data URIs once */
const PIECE_DATA_URIS = {};
Object.keys(PIECE_SVGS).forEach(key => {
    PIECE_DATA_URIS[key] = svgToDataUri(PIECE_SVGS[key]);
});

/* chessboard.js calls this function per piece —
   returning a data URI guarantees the image
   renders with no network request. */
function pieceTheme(piece) {
    return PIECE_DATA_URIS[piece] || "";
}

