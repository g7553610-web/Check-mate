========================================= */

function capitalize(text) {
    if (!text) return "Unknown";
    return text.charAt(0).toUpperCase() + text.slice(1);
}


/* =========================================
   SHARE GAME
========================================= */
/* =========================================
   SHARE GAME
   Tries three copy strategies in order so
   this works on file:// pages and in every
   browser, including ones that block the
   Clipboard API on insecure origins.
========================================= */

function shareGame() {

    console.log("[shareGame] clicked");

    if (!currentGame || !currentGame.pgn) {
        showStatus("Load a game first before sharing.", "error");
        return;
    }

    const payload = {
        w: (currentGame.white && currentGame.white.username) || "White",
        b: (currentGame.black && currentGame.black.username) || "Black",
        r: getGameResult(currentGame),
        t: currentGame.time_class || "?",
        p: currentGame.pgn
    };

    let encoded;
    try {
        encoded = btoa(unescape(encodeURIComponent(JSON.stringify(payload))));
    } catch (err) {
        console.error("[shareGame] encode failed:", err);
        showStatus("Could not build share link for this game.", "error");
        return;
    }

    const url = `${location.origin}${location.pathname}#share=${encoded}`;

    /* ---- 1. Modern clipboard API (secure contexts) ---- */
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(
            () => {
                showStatus("Share link copied to your clipboard!", "success");
                showShareFallback(url, true);
            },
            (err) => {
                console.warn("[shareGame] clipboard API denied:", err);
                legacyCopy(url);
            }
        );
        return;
    }

    /* ---- 2. Legacy execCommand fallback (file://, older browsers) ---- */
    legacyCopy(url);
}

function legacyCopy(url) {

    try {
        const ta = document.createElement("textarea");
        ta.value = url;
        ta.setAttribute("readonly", "");
        ta.style.position = "fixed";
        ta.style.top = "-1000px";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        ta.setSelectionRange(0, url.length);

        const ok = document.execCommand("copy");
        document.body.removeChild(ta);

        if (ok) {
            showStatus("Share link copied to your clipboard!", "success");
            showShareFallback(url, true);
        } else {
            showShareFallback(url, false);
        }
    } catch (err) {
        console.warn("[shareGame] legacy copy failed:", err);
        showShareFallback(url, false);
    }
}

/* Renders a small box under the panel that shows the URL and
   lets the user copy it manually if the automatic copy fails. */
function showShareFallback(url, copied) {

    const panel = document.querySelector(".analysis-panel");
    if (!panel) {
        if (!copied) window.prompt("Copy your share link:", url);
        return;
    }

    let box = document.getElementById("share-fallback");
    if (!box) {
        box = document.createElement("div");
        box.id = "share-fallback";
        box.className = "share-fallback";
        panel.appendChild(box);
    }

    box.innerHTML = `
        <p class="share-fallback-label">
            ${copied
                ? "✅ Link copied. You can also copy it from here:"
                : "⚠️ Automatic copy blocked. Copy the link below:"}
        </p>
        <input type="text" id="share-url-input" readonly>
    `;

    const input = document.getElementById("share-url-input");
    input.value = url;
    input.addEventListener("focus", () => input.select());
    input.addEventListener("click", () => input.select());

    if (!copied) {
        input.focus();
        input.select();
    }
}

/* =========================================
   DOWNLOAD PGN
========================================= */

function downloadPgn() {

    if (!currentGame || !currentGame.pgn) {
        showStatus("Load a game first.", "error");
        return;
    }

    const w = (currentGame.white && currentGame.white.username) || "White";
    const b = (currentGame.black && currentGame.black.username) || "Black";

    const blob = new Blob([currentGame.pgn], {
        type: "application/x-chess-pgn"
    });

    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = `${w}_vs_${b}.pgn`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(a.href);
}


/* =========================================
   LOAD SHARED GAME FROM URL HASH
========================================= */

function loadSharedGameFromUrl() {

    const hash = location.hash || "";
    const match = hash.match(/#share=(.+)$/);
    if (!match) return false;

    try {

        const json = decodeURIComponent(escape(atob(match[1])));
        const data = JSON.parse(json);

        currentGame = {
            white: { username: data.w },
            black: { username: data.b },
            time_class: data.t,
            pgn: data.p,
            end_time: null
        };

        window.loadedGames = [currentGame];

        setTimeout(() => analyseGame(0), 300);

        return true;

    } catch (err) {
        console.error("Could not parse shared game:", err);
        showStatus("This share link appears to be corrupted.", "error");
        return false;
    }
}


