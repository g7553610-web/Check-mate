/* =========================================
   FETCH CHESS.COM GAMES
========================================= */

async function fetchGames() {

    const usernameInput = document.getElementById("username");
    const username = usernameInput.value.trim();

    if (username === "") {
        showStatus("Please enter your Chess.com username.", "error");
        return;
    }

    showStatus("Fetching your Chess.com games...", "loading");

    try {

        const archiveResponse = await fetch(
            `https://api.chess.com/pub/player/${encodeURIComponent(
                username.toLowerCase()
            )}/games/archives`
        );

        if (archiveResponse.status === 404) {
            throw new Error("No Chess.com account found with that username.");
        }

        if (!archiveResponse.ok) {
            throw new Error(
                `Chess.com API error (status ${archiveResponse.status}). Please try again.`
            );
        }

        const archiveData = await archiveResponse.json();
        const archives = archiveData.archives;

        if (!archives || archives.length === 0) {
            throw new Error("No games found for this user.");
        }

        let games = [];
        let archiveIndex = archives.length - 1;

        while (
            games.length === 0 &&
            archiveIndex >= 0 &&
            archiveIndex >= archives.length - 6
        ) {
            const gamesResponse = await fetch(archives[archiveIndex]);

            if (gamesResponse.ok) {
                const gamesData = await gamesResponse.json();
                if (gamesData.games && gamesData.games.length > 0) {
                    games = gamesData.games;
                }
            }

            archiveIndex--;
        }

        if (!games || games.length === 0) {
            throw new Error("No recent games found for this user.");
        }

        showStatus(`Successfully found ${games.length} games!`, "success");
        displayGames(games.slice(-12).reverse());

    } catch (error) {

        console.error(error);

        if (error instanceof TypeError) {
            showStatus(
                "Network error — check your connection and try again.",
                "error"
            );
        } else {
            showStatus(error.message, "error");
        }
    }
}


/* =========================================
   STATUS MESSAGE
========================================= */

function showStatus(message, type) {

    const status = document.getElementById("status");
    if (!status) return;

    status.innerText = message;

    if (type === "error") status.style.color = "#ff5c5c";
    else if (type === "success") status.style.color = "#d4af37";
    else status.style.color = "#f5d76e";
}


/* =========================================
   DISPLAY GAMES
========================================= */

function displayGames(games) {

    const container = document.getElementById("games-container");
    if (!container) return;

    container.innerHTML = "";

    games.forEach((gameData, index) => {

        const card = document.createElement("div");
        card.className = "game-card";

        const whitePlayer =
            (gameData.white && gameData.white.username) || "Unknown";

        const blackPlayer =
            (gameData.black && gameData.black.username) || "Unknown";

        const resultText = getGameResult(gameData);
        const timeControl = gameData.time_class || "Unknown";

        const gameDate = gameData.end_time
            ? new Date(gameData.end_time * 1000).toLocaleDateString()
            : "Unknown";

        card.innerHTML = `
            <h3>♟ GAME ${index + 1}</h3>
            <p><strong>White:</strong> ${escapeHtml(whitePlayer)}</p>
            <p><strong>Black:</strong> ${escapeHtml(blackPlayer)}</p>
            <p><strong>Type:</strong> ${capitalize(timeControl)}</p>
            <p><strong>Date:</strong> ${gameDate}</p>
            <p><strong>Result:</strong> ${resultText}</p>
            <button type="button" class="analyse-btn" data-index="${index}">
                ANALYSE GAME
            </button>
        `;

        container.appendChild(card);
    });

    container.querySelectorAll(".analyse-btn").forEach(btn => {
        btn.addEventListener("click", () => {
            analyseGame(parseInt(btn.dataset.index, 10));
        });
    });

    window.loadedGames = games;

    const gamesSection = document.getElementById("games-section");
    if (gamesSection) {
        gamesSection.classList.remove("hidden");
        gamesSection.scrollIntoView({ behavior: "smooth" });
    }
}


/* =========================================
   ESCAPE HTML
========================================= */

function escapeHtml(text) {
    const div = document.createElement("div");
    div.innerText = text;
    return div.innerHTML;
}


/* =========================================
   GET GAME RESULT
========================================= */

function getGameResult(gameData) {

    const whiteResult = gameData.white && gameData.white.result;
    const blackResult = gameData.black && gameData.black.result;

    if (whiteResult === "win") return "White Won";
    if (blackResult === "win") return "Black Won";

    if (
        whiteResult === "agreed" ||
        whiteResult === "stalemate" ||
        whiteResult === "repetition" ||
        whiteResult === "insufficient" ||
        whiteResult === "50move" ||
        whiteResult === "timevsinsufficient"
    ) {
        return "Draw";
    }

    if (whiteResult === "timeout") return "Black Won on Time";
    if (blackResult === "timeout") return "White Won on Time";

    return "Game Finished";
}


/* =========================================
   ANALYSE SELECTED GAME
========================================= */

function analyseGame(index) {

    console.log("[analyseGame] index:", index);

    currentGame = window.loadedGames && window.loadedGames[index];

    if (!currentGame || !currentGame.pgn) {
        showStatus("This game has no move data available to analyse.", "error");
        return;
    }

    const analyserSection = document.getElementById("analyser");
    if (analyserSection) analyserSection.classList.remove("hidden");

    const whiteName =
        (currentGame.white && currentGame.white.username) || "Unknown";
    const blackName =
        (currentGame.black && currentGame.black.username) || "Unknown";

    setText("white-player", whiteName);
    setText("black-player", blackName);
    setText("game-result", getGameResult(currentGame));
    setText("time-control", capitalize(currentGame.time_class));

    game = new Chess();
    const loadedOk = game.load_pgn(currentGame.pgn);

    if (!loadedOk) {
        showStatus(
            "Could not read this game's move data (unsupported PGN format).",
            "error"
        );
        return;
    }

    moves = game.history();

    if (moves.length === 0) {
        showStatus("This game has no recorded moves.", "error");
        return;
    }

    game.reset();
    currentMoveIndex = 0;

    try {
        classifications = classifyGame(moves);
    } catch (err) {
        console.error("[analyseGame] classifyGame failed:", err);
        classifications = moves.map(san => ({
            san,
            tag: "Good",
            color: "w",
            eval: 0
        }));
    }

    safeCall(renderAccuracy);
    safeCall(renderClassificationCounts);
    safeCall(() => updateEvalBar(0));

    if (board) {
        try { board.destroy(); } catch (e) { console.warn(e); }
    }

    try {
        board = Chessboard("board", {
            position: "start",
            draggable: false,
            pieceTheme: pieceTheme
        });

        requestAnimationFrame(() => {
            try { board.resize(); } catch (e) { console.warn(e); }
        });
    } catch (err) {
        console.error("[analyseGame] Chessboard init failed:", err);
        showStatus("Could not initialise the chessboard.", "error");
        return;
    }

    safeCall(displayMoveHistory);

    setText("move-display", "Start Position");
    const tagEl = document.getElementById("move-tag");
    if (tagEl) tagEl.innerHTML = "";

    safeCall(saveCurrentGameToHistory);

    if (analyserSection) {
        analyserSection.scrollIntoView({ behavior: "smooth" });
    }
}


/* =========================================
   CLASSIFY GAME
========================================= */

function classifyGame(moveList) {

    const work = new Chess();
    const result = [];

    for (let i = 0; i < moveList.length; i++) {

        const san = moveList[i];
        const color = work.turn();

        const beforeEval = evaluatePosition(work, color);
        const bestLine = findBestMove(work, color);

        const made = work.move(san);

        if (!made) {
            result.push({ san, tag: "Good", color, eval: beforeEval });
            continue;
        }

        const afterEval = evaluatePosition(work, color);
        const oppColor = color === "w" ? "b" : "w";

        const hangingAfter = hangingValue(work, color, oppColor);

        const bestWasCapture =
            bestLine &&
            (bestLine.flags.includes("c") || bestLine.flags.includes("e"));

        const playedWasCapture =
            made.flags.includes("c") || made.flags.includes("e");

        const isSacrifice =
            !playedWasCapture &&
            hangingAfter > 0 &&
            afterEval >= beforeEval - 1;

        let tag = "Good";

        if (hangingAfter >= 3) {
            tag = "Blunder";
        } else if (hangingAfter >= 1) {
            tag = "Miss";
        } else if (isSacrifice && afterEval > beforeEval + 0.5) {
            tag = "Brilliant";
        } else if (
            bestWasCapture &&
            !playedWasCapture &&
            bestLine &&
            bestLine.value >= 3
        ) {
            tag = "Miss";
        } else if (
            bestLine &&
            made.from === bestLine.from &&
            made.to === bestLine.to
        ) {
            tag = "Best";
        } else if (afterEval > beforeEval + 0.8) {
            tag = "Great";
        } else if (afterEval < beforeEval - 0.8) {
            tag = "Inaccuracy";
        } else {
            tag = "Good";
        }

        result.push({ san, tag, color, eval: afterEval });
    }

    return result;
}


/* =========================================
   EVALUATE POSITION
========================================= */

function evaluatePosition(chess, color) {

    const grid = chess.board();
    let score = 0;

    for (let r = 0; r < 8; r++) {
        for (let f = 0; f < 8; f++) {

            const sq = grid[r][f];
            if (!sq) continue;

            const v = PIECE_VALUE[sq.type] || 0;
            score += sq.color === color ? v : -v;
        }
    }

    return score;
}


/* =========================================
   FIND BEST MOVE
========================================= */

function findBestMove(chess, color) {

    const legal = chess.moves({ verbose: true });
    let best = null;

    for (const mv of legal) {

        const clone = new Chess(chess.fen());
        const made = clone.move(mv);
        if (!made) continue;

        let value = 0;

        if (made.captured) value += PIECE_VALUE[made.captured] || 0;
        if (made.promotion) value += PIECE_VALUE[made.promotion] || 0;
        if (clone.in_checkmate()) value += 100;

        if (!best || value > best.value) {
            best = { ...mv, value };
        }
    }

    return best;
}


/* =========================================
   HANGING VALUE
========================================= */

function hangingValue(chess, color, oppColor) {

    const grid = chess.board();
    let total = 0;

    for (let r = 0; r < 8; r++) {
        for (let f = 0; f < 8; f++) {

            const sq = grid[r][f];
            if (!sq || sq.color !== color) continue;

            const squareName = "abcdefgh"[f] + (8 - r);

            const attackers = chess.attackers(squareName, oppColor);
            if (attackers.length === 0) continue;

            const defenders = chess.attackers(squareName, color);

            if (defenders.length < attackers.length) {
                total += PIECE_VALUE[sq.type] || 0;
            }
        }
    }

    return total;
}


/* =========================================
   RENDER ACCURACY
========================================= */

function renderAccuracy() {

    let whiteScore = 0, blackScore = 0;
    let whiteMoves = 0, blackMoves = 0;

    classifications.forEach(c => {

        const w = TAG_WEIGHTS[c.tag] ?? 0.7;

        if (c.color === "w") {
            whiteScore += w;
            whiteMoves++;
        } else {
            blackScore += w;
            blackMoves++;
        }
    });

    const whiteAcc = whiteMoves
        ? Math.round((whiteScore / whiteMoves) * 100)
        : 0;

    const blackAcc = blackMoves
        ? Math.round((blackScore / blackMoves) * 100)
        : 0;

    setText("white-accuracy", `${whiteAcc}%`);
    setText("black-accuracy", `${blackAcc}%`);
}


/* =========================================
   RENDER CLASSIFICATION COUNTS
========================================= */

function renderClassificationCounts() {

    const container = document.getElementById("classification-counts");
    if (!container) return;

    const order = [
        "Brilliant",
        "Great",
        "Best",
        "Good",
        "Inaccuracy",
        "Miss",
        "Blunder"
    ];

    const counts = {};
    order.forEach(t => (counts[t] = 0));
    classifications.forEach(c => {
        if (counts[c.tag] !== undefined) counts[c.tag]++;
    });

    container.innerHTML = order
        .filter(t => counts[t] > 0)
        .map(
            t => `
                <span class="class-chip class-${t.toLowerCase()}">
                    <span class="chip-icon">${TAG_ICONS[t]}</span>
                    ${t}
                    <span class="chip-count">${counts[t]}</span>
                </span>
            `
        )
        .join("");
}


/* =========================================
   UPDATE EVAL BAR
========================================= */

function updateEvalBar(moveIndex) {

    const fill = document.getElementById("eval-fill");
    const scoreEl = document.getElementById("eval-score");
    if (!fill || !scoreEl) return;

    if (moveIndex === 0 || classifications.length === 0) {
        fill.style.height = "50%";
        scoreEl.innerText = "0.0";
        return;
    }

    const last =
        classifications[
            Math.min(moveIndex - 1, classifications.length - 1)
        ];

    const ev = last ? last.eval : 0;

    const clamped = Math.max(-10, Math.min(10, ev));
    const whitePct = 50 + (clamped / 10) * 50;

    fill.style.height = `${whitePct}%`;
    scoreEl.innerText = (ev > 0 ? "+" : "") + ev.toFixed(1);
}


/* =========================================
   SAVE CURRENT GAME TO HISTORY
========================================= */

function saveCurrentGameToHistory() {

    if (typeof saveHistoryEntry !== "function") return;
    if (typeof isLoggedIn !== "function" || !isLoggedIn()) return;

    const entry = {
        id: `hist_${Date.now()}_${Math.floor(Math.random() * 10000)}`,
        white: (currentGame.white && currentGame.white.username) || "Unknown",
        black: (currentGame.black && currentGame.black.username) || "Unknown",
        result: getGameResult(currentGame),
        timeClass: currentGame.time_class || "Unknown",
        endTime: currentGame.end_time || null,
        pgn: currentGame.pgn,
        savedAt: new Date().toISOString()
    };

    const result = saveHistoryEntry(entry);

    if (result && result.ok && !result.duplicate) {
        renderHistory();
    }
}


/* =========================================
   RENDER SAVED HISTORY LIST
========================================= */

function renderHistory() {

    const emptyState = document.getElementById("history-empty");
    const container = document.getElementById("history-container");

    if (!emptyState || !container) return;

    if (
        typeof getHistory !== "function" ||
        typeof isLoggedIn !== "function" ||
        !isLoggedIn()
    ) {
        emptyState.textContent = "Sign in to start saving your analysed games.";
        emptyState.classList.remove("hidden");
        container.innerHTML = "";
        return;
    }

    const history = getHistory();

    if (history.length === 0) {
        emptyState.textContent =
            "No saved analyses yet. Analyse a game above to add it here.";
        emptyState.classList.remove("hidden");
        container.innerHTML = "";
        return;
    }

    emptyState.classList.add("hidden");
    container.innerHTML = "";

    history.forEach(entry => {

        const card = document.createElement("div");
        card.className = "game-card";

        const savedDate = entry.endTime
            ? new Date(entry.endTime * 1000).toLocaleDateString()
            : new Date(entry.savedAt).toLocaleDateString();

        card.innerHTML = `
            <h3>♟ ${escapeHtml(entry.white)} vs ${escapeHtml(entry.black)}</h3>
            <p><strong>Result:</strong> ${escapeHtml(entry.result)}</p>
            <p><strong>Type:</strong> ${capitalize(entry.timeClass)}</p>
            <p><strong>Date:</strong> ${savedDate}</p>
            <div class="history-actions">
                <button type="button" class="reanalyse-btn" data-id="${entry.id}">
                    RE-OPEN
                </button>
                <button type="button" class="delete-btn" data-id="${entry.id}">
                    DELETE
                </button>
            </div>
        `;

        container.appendChild(card);
    });

    container.querySelectorAll(".reanalyse-btn").forEach(btn => {
        btn.addEventListener("click", () => {
            const entry = getHistory().find(h => h.id === btn.dataset.id);
            if (entry) reopenHistoryEntry(entry);
        });
    });

    container.querySelectorAll(".delete-btn").forEach(btn => {
        btn.addEventListener("click", () => {
            deleteHistoryEntry(btn.dataset.id);
            renderHistory();
        });
    });
}


/* =========================================
   REOPEN A SAVED HISTORY ENTRY
========================================= */

function reopenHistoryEntry(entry) {

    currentGame = {
        white: { username: entry.white },
        black: { username: entry.black },
        time_class: entry.timeClass,
        pgn: entry.pgn,
        end_time: entry.endTime
    };

    window.loadedGames = [currentGame];
    analyseGame(0);
}


/* =========================================
   DISPLAY MOVE HISTORY
========================================= */

function displayMoveHistory() {

    const movesList = document.getElementById("moves-list");
    if (!movesList) return;

    movesList.innerHTML = "";

    moves.forEach((move, index) => {

        const moveElement = document.createElement("div");
        moveElement.className = "move-item";
        moveElement.id = `move-${index}`;
        moveElement.tabIndex = 0;

        const moveNumber = Math.floor(index / 2) + 1;
        const cls = classifications[index];
        const tag = cls ? cls.tag : "";

        moveElement.innerText =
            index % 2 === 0
                ? `${moveNumber}. ${move}`
                : move;

        if (tag) {
            moveElement.classList.add(`tag-${tag.toLowerCase()}`);
            moveElement.title = tag;
        }

        moveElement.onclick = function () {
            goToMove(index);
        };

        moveElement.addEventListener("keydown", event => {
            if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                goToMove(index);
            }
        });

        movesList.appendChild(moveElement);
    });
}


/* =========================================
   NAVIGATION
========================================= */

function nextMove() {
    if (!game) return;
    if (currentMoveIndex >= moves.length) return;

    game.move(moves[currentMoveIndex]);
    currentMoveIndex++;
    updateBoard();
}

function previousMove() {
    if (!game) return;
    if (currentMoveIndex <= 0) return;

    game.undo();
    currentMoveIndex--;
    updateBoard();
}

function goToStart() {
    if (!game) return;
    game.reset();
    currentMoveIndex = 0;
    updateBoard();
}

function goToEnd() {
    if (!game) return;

    game.reset();

    for (let i = 0; i < moves.length; i++) {
        game.move(moves[i]);
    }

    currentMoveIndex = moves.length;
    updateBoard();
}

function goToMove(index) {
    if (!game) return;

    game.reset();

    for (let i = 0; i <= index; i++) {
        game.move(moves[i]);
    }

    currentMoveIndex = index + 1;
    updateBoard();
}


/* =========================================
   UPDATE BOARD
========================================= */

function updateBoard() {

    if (!board || !game) return;

    board.position(game.fen());

    const moveDisplay = document.getElementById("move-display");
    const tagEl = document.getElementById("move-tag");

    if (currentMoveIndex === 0) {

        if (moveDisplay) moveDisplay.innerText = "Start Position";
        if (tagEl) tagEl.innerHTML = "";

    } else {

        const lastMove = moves[currentMoveIndex - 1];
        const moveNumber = Math.ceil(currentMoveIndex / 2);

        if (moveDisplay) {
            moveDisplay.innerText = `Move ${moveNumber}: ${lastMove}`;
        }

        const cls = classifications[currentMoveIndex - 1];

        if (tagEl) {
            if (cls) {
                tagEl.innerHTML = `
                    <span class="class-chip class-${cls.tag.toLowerCase()}">
                        <span class="chip-icon">${TAG_ICONS[cls.tag] || ""}</span>
                        ${cls.tag}
                    </span>
                `;
            } else {
                tagEl.innerHTML = "";
            }
        }
    }

    updateEvalBar(currentMoveIndex);

    document.querySelectorAll(".move-item").forEach(el => {
        el.classList.remove("active");
    });

    if (currentMoveIndex > 0) {

        const activeMove =
            document.getElementById(`move-${currentMoveIndex - 1}`);

        if (activeMove) {
            activeMove.classList.add("active");

            /* Scroll ONLY the inner #moves-list container, never the
               page. Calling scrollIntoView() here also scrolled the
               whole document, which dragged the chessboard upward on
               every NEXT click. */
            const listEl = document.getElementById("moves-list");
            if (listEl) {
                const chipTop = activeMove.offsetTop;
                const chipBottom = chipTop + activeMove.offsetHeight;
                const viewTop = listEl.scrollTop;
                const viewBottom = viewTop + listEl.clientHeight;

                if (chipTop < viewTop) {
                    listEl.scrollTop = chipTop - 8;
                } else if (chipBottom > viewBottom) {
                    listEl.scrollTop =
                        chipBottom - listEl.clientHeight + 8;
                }
            }
        }
    }
}



/* =========================================
